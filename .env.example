# Environment Configuration for AI Coding Tutor for C Programming

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Optional External AI API Keys (Leave blank to use the high-accuracy built-in rule-based static analyzer)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Sandbox Configuration
# Set to true to allow local GCC compilation if installed on host
ALLOW_LOCAL_COMPILATION=true
MAX_EXEC_TIMEOUT=3.0
